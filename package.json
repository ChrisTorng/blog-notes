{
  "name": "blog-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/export.js && node --check src/views.js && node --check src/auth.js && node --check src/data.js && node --check src/feeds.js && node --check src/http.js && node --check src/site-theme.js && node --check public/notes/editor.js && node --check public/notes/editor-state.js && npm test",
    "deploy": "wrangler deploy",
    "test:integration": "node scripts/integration-test.mjs",
    "types": "wrangler types --include-runtime=false",
    "build:shared": "node scripts/build-shared.mjs",
    "predev": "npm run build:shared",
    "precheck": "npm run build:shared",
    "pretest": "npm run build:shared",
    "predeploy": "npm run build:shared"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.0",
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "markdown-it": "^14.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": ">=22"
  }
}
